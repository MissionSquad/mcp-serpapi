# SerpApi MCP Server Configuration

# MCP Server Configuration
# Host to bind the server to (default: 0.0.0.0)
MCP_HOST=0.0.0.0

# Port to run the server on (default: 8000)
MCP_PORT=8000

# SerpApi API key for local stdio use (src/stdio.py) only. The HTTP server never
# reads it. Leave it unset on shared MissionSquad deployments: each user's key
# arrives with every tool call as the hidden `apiKey` secret, which takes precedence.
# SERPAPI_API_KEY=